{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "kalamlabs.in"
        }
      ],
      "destination": "https://kalamlabs.io/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.kalamlabs.in"
        }
      ],
      "destination": "https://kalamlabs.io/:path*",
      "permanent": true
    }
  ]
}
